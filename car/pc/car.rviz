Panels:
  - Class: rviz_common/Displays
    Name: Displays
  - Class: rviz_common/Views
    Name: Views
Visualization Manager:
  Class: ""
  Displays:
    - Class: rviz_default_plugins/Grid
      Name: Grid
      Enabled: true
      Cell Size: 1
      Plane Cell Count: 30
    - Class: rviz_default_plugins/Map
      Name: Map
      Enabled: true
      Topic:
        Value: /map
        Durability Policy: Transient Local
        Reliability Policy: Reliable
        History Policy: Keep Last
        Depth: 5
      Alpha: 0.8
      Color Scheme: map
    - Class: rviz_default_plugins/LaserScan
      Name: LiDAR /scan_raw
      Enabled: true
      Topic:
        Value: /scan_raw
        Reliability Policy: Best Effort
        Durability Policy: Volatile
        History Policy: Keep Last
        Depth: 5
      Size (m): 0.04
      Style: Flat Squares
      Color Transformer: FlatColor
      Color: 239; 41; 41
    - Class: rviz_default_plugins/LaserScan
      Name: Depth camera /depth_scan
      Enabled: true
      Topic:
        Value: /depth_scan
        Reliability Policy: Reliable
        Durability Policy: Volatile
        History Policy: Keep Last
        Depth: 5
      Size (m): 0.05
      Style: Flat Squares
      Color Transformer: FlatColor
      Color: 252; 175; 62
    - Class: rviz_default_plugins/TF
      Name: TF
      Enabled: true
      Show Names: false
      Marker Scale: 0.4
    - Class: rviz_default_plugins/Path
      Name: Nav2 plan /plan
      Enabled: true
      Topic:
        Value: /plan
        Reliability Policy: Reliable
        Durability Policy: Volatile
      Color: 25; 255; 0
    - Class: rviz_default_plugins/Path
      Name: Drive route /drive_to/path
      Enabled: true
      Topic:
        Value: /drive_to/path
        Reliability Policy: Reliable
        Durability Policy: Volatile
      Color: 52; 101; 164
  Enabled: true
  Global Options:
    Fixed Frame: map
    Background Color: 48; 48; 48
    Frame Rate: 15
  Name: root
  Tools:
    - Class: rviz_default_plugins/MoveCamera
    - Class: rviz_default_plugins/Select
    - Class: rviz_default_plugins/SetGoal
      Topic:
        Value: /goal_pose
    - Class: rviz_default_plugins/PublishPoint
  Value: true
  Views:
    Current:
      Class: rviz_default_plugins/TopDownOrtho
      Name: Current View
      Scale: 60
      X: 0
      Y: 0
    Saved: ~
Window Geometry:
  Height: 900
  Width: 1400
