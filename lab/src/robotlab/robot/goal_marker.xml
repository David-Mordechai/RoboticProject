<!--
  Goal flag for the navigate task: visual only (no collision, group 2 so it renders but the LiDAR, which casts on
  groups 0-1, never sees it). A mocap body the task moves to the current goal.
-->
<mujoco model="goal_marker">
  <worldbody>
    <body name="flag">
      <geom type="cylinder" size="0.008 0.25" pos="0 0 0.25" contype="0" conaffinity="0" group="2" rgba="0.9 0.9 0.9 1"/>
      <geom type="box" size="0.07 0.004 0.045" pos="0.07 0 0.45" contype="0" conaffinity="0" group="2" rgba="0.95 0.2 0.2 1"/>
      <geom type="cylinder" size="0.2 0.002" pos="0 0 0.002" contype="0" conaffinity="0" group="2" rgba="0.95 0.2 0.2 0.35"/>
    </body>
  </worldbody>
</mujoco>
