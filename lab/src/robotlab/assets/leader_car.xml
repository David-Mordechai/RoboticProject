<!--
  Leader car for the follow task: same body as mentorpi_a1.xml but kinematic (no joints).
  mjlab wraps a fixed-base body as a mocap body, and the task script moves it every step.
  Its chassis (group 2) still collides with the follower's chassis.
-->
<mujoco model="leader_car">
  <default>
    <default class="visual">
      <geom contype="0" conaffinity="0"/>
    </default>
  </default>
  <worldbody>
    <body name="chassis">
      <geom name="chassis" type="box" size="0.1065 0.0795 0.02" pos="0 0 0.03" contype="2" conaffinity="2" rgba="0.15 0.45 0.9 1"/>
      <geom class="visual" type="box" size="0.08 0.06 0.004" pos="-0.01 0 0.06" rgba="0.2 0.2 0.2 1"/>
      <geom class="visual" type="cylinder" size="0.019 0.016" pos="-0.05 0 0.08" rgba="0.15 0.15 0.15 1"/>
      <geom class="visual" type="cylinder" size="0.0325 0.0125" euler="90 0 0" pos="0.0725 0.0665 0" rgba="0.1 0.1 0.1 1"/>
      <geom class="visual" type="cylinder" size="0.0325 0.0125" euler="90 0 0" pos="0.0725 -0.0665 0" rgba="0.1 0.1 0.1 1"/>
      <geom class="visual" type="cylinder" size="0.0325 0.0125" euler="90 0 0" pos="-0.0725 0.0665 0" rgba="0.1 0.1 0.1 1"/>
      <geom class="visual" type="cylinder" size="0.0325 0.0125" euler="90 0 0" pos="-0.0725 -0.0665 0" rgba="0.1 0.1 0.1 1"/>
    </body>
  </worldbody>
</mujoco>
